{
  "name": "@quantumswap/v2-core",
  "version": "1.0.0",
  "description": "Core contracts for the QuantumSwap V2 protocol on the QuantumCoin blockchain (modified fork of @uniswap/v2-core)",
  "license": "GPL-3.0-or-later",
  "files": [
    "contracts",
    "!contracts/test"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quantumswapdex/v2-core.git"
  },
  "homepage": "https://github.com/quantumswapdex/v2-core#readme",
  "bugs": {
    "url": "https://github.com/quantumswapdex/v2-core/issues"
  },
  "keywords": [
    "quantumswap",
    "quantumcoin",
    "v2",
    "core",
    "quantumswap-v2"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "compile": "node scripts/compile.js",
    "test": "npm run compile && node scripts/devnet.js ensure && node --test --test-concurrency=1",
    "test:integration": "node scripts/devnet.js ensure && node scripts/devnet-integration.js",
    "prepublishOnly": "npm run compile"
  },
  "devDependencies": {
    "@quantumcoin/solc": "^0.7.6",
    "quantumcoin": "^8.0.2"
  }
}
